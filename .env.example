# ---------------------------------------------------------------------------
# SmartTaxIQ — environment
# ---------------------------------------------------------------------------
# Copy this file to .env.local and fill in what you have. Everything here is
# optional: with none of it set the site builds and runs exactly as before.
# Each value switches on its own part of the lead system and needs no code
# change. The walkthrough is in LEAD-SYSTEM-SETUP.md.

# --- Canonical URL ----------------------------------------------------------
SITE_URL=https://smarttaxiq.com

# --- Email delivery and the mailing list — both from Resend -----------------
# One account and one API key cover sending and the list. This site sends over
# Resend's HTTPS API rather than SMTP: serverless hosts routinely block
# outbound SMTP, and a hanging mail host would stall a form submission until
# the platform killed it.
#
# resend.com → API keys. MAIL_FROM must be on a domain verified in Resend.
RESEND_API_KEY=
MAIL_FROM="SmartTaxIQ <no-reply@smarttaxiq.com>"

# --- The mailing list -------------------------------------------------------
# Two providers are supported and the code uses whichever is configured, so
# changing campaign tools later is an env change rather than a code change.
# Mailchimp wins if both are filled in.
#
# MAILCHIMP (in use):
#   Use the SAME api key and audience id as the Carter Cole site. That is the
#   entire mechanism behind "one list across both websites" — signups from
#   here and from there become one contact set, kept apart by a `site-` tag.
MAILCHIMP_API_KEY=
MAILCHIMP_AUDIENCE_ID=
MAILCHIMP_SERVER_PREFIX=

# RESEND (alternative, currently unused):
#   Set this INSTEAD of the Mailchimp values to run the list from Resend using
#   the same key that already sends this site's email. Leave blank for now.
RESEND_AUDIENCE_ID=

# --- Lead storage (optional) ------------------------------------------------
# Point these at the SAME Supabase project the Carter Cole site uses and every
# lead from both sites lands in one dashboard. Leave blank and this site keeps
# no database at all — leads still reach Mailchimp and the alert channels.
# NEVER prefix the service-role key with NEXT_PUBLIC_: it bypasses row-level
# security and can read and delete the entire list.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Lead alerts ------------------------------------------------------------
# Comma-separate for more than one recipient.
LEAD_NOTIFY_EMAIL=

# Text alerts. Not free: about $1.15/month for the number plus roughly $0.008
# per message. Leave blank for email-only alerts.
# All numbers in E.164 format: +13135551234
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
LEAD_NOTIFY_SMS=

# --- Calendly ---------------------------------------------------------------
# LIVE and already working — the real link is the default in src/lib/site.ts:
#   https://calendly.com/lashandasmarttaxiq/30min
# You only need this variable to OVERRIDE it, e.g. to point a staging build at
# a test event so it doesn't put real bookings in the calendar.
# Availability (Mon–Thu 9:30–5:00 ET) is configured inside Calendly.
NEXT_PUBLIC_CALENDLY_URL=

# --- Webhook secrets --------------------------------------------------------
# Long random strings. They go in the webhook URLs pasted into JotForm and
# Calendly and stop anyone who guesses the path injecting junk into the list.
JOTFORM_WEBHOOK_SECRET=
CALENDLY_WEBHOOK_SECRET=

# --- Analytics --------------------------------------------------------------
# GA4 → Admin → Data streams → Measurement ID (G-XXXXXXXXXX).
# Use a SEPARATE GA4 property from the Carter Cole site, so the two domains
# report independently.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# Google Ads conversion labels, one per action worth money.
NEXT_PUBLIC_ADS_LABEL_TIPS=
NEXT_PUBLIC_ADS_LABEL_NEWSLETTER=
NEXT_PUBLIC_ADS_LABEL_CONTACT=
NEXT_PUBLIC_ADS_LABEL_INTAKE=
NEXT_PUBLIC_ADS_LABEL_BOOKING=
NEXT_PUBLIC_ADS_LABEL_PHONE=
